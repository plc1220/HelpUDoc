# syntax=docker/dockerfile:1.7
FROM node:20-bookworm-slim AS base

WORKDIR /app

# Local `file:` dependency (@helpudoc/contracts) resolves to ../packages/contracts from this package.json directory.
COPY packages/contracts /packages/contracts

# Copy dependency manifests first for better layer caching
COPY backend/package*.json ./
COPY backend/tsconfig.json ./

RUN --mount=type=cache,target=/root/.npm \
  npm ci --legacy-peer-deps

# Copy the rest of the backend source code
COPY backend/src ./src

# Operational scripts. Deploy pipelines run `scripts/repair-governed-packages.ts --verify` to prove
# every active skill version still resolves to a materialized package before traffic is served.
COPY backend/scripts ./scripts

# Ensure workspaces directory exists
RUN mkdir -p workspaces

ENV NODE_ENV=production \
    PORT=3000

# Run the TypeScript entrypoint directly with ts-node
CMD ["npx", "ts-node", "--transpile-only", "src/index.ts"]
