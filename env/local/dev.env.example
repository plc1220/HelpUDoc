# Local development env (export before running backend/agent/frontend)
# Usage:
#   set -a; source env/local/dev.env; set +a
#   (or) ENV_FILE=../env/local/dev.env npm run dev (backend)

NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me
SESSION_NAME=helpudoc.sid
SESSION_TTL_SECONDS=604800
AUTH_MODE=headers
DEFAULT_USER_ID=local-admin@local.com
DEFAULT_USER_NAME=admin
DEFAULT_USER_EMAIL=admin@local.com
AGENT_URL=http://localhost:8001
# Direct OfficeCLI execution is available in the agent container. Native-host
# agent runs report OFFICECLI_UNAVAILABLE unless the pinned binary is installed.
KNOWLEDGE_ENRICHMENT_MODE=gemini-lite
KNOWLEDGE_MAP_CONCURRENCY=4
# MarkItDown is the universal local-file conversion facade. Native PDF/DOCX
# sidecars remain authoritative for evidence locators.
KNOWLEDGE_MARKITDOWN_MODE=primary
KNOWLEDGE_OCR_MODE=auto
KNOWLEDGE_OCR_TEXT_THRESHOLD=40
KNOWLEDGE_OCR_BATCH_SIZE=6
KNOWLEDGE_OCR_CONCURRENCY=4
KNOWLEDGE_DEDICATED_WORKER=false
KNOWLEDGE_WORKER_CONCURRENCY=2
KNOWLEDGE_RETRIEVAL_MODE=lexical-graph
KNOWLEDGE_VECTOR_ENABLED=false
KNOWLEDGE_MULTIMODAL_EMBEDDINGS=false
KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-2
KNOWLEDGE_EMBEDDING_DIMENSIONS=768

REDIS_URL=redis://localhost:6379
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=helpudoc
POSTGRES_USER=helpudoc
POSTGRES_PASSWORD=helpudoc
DATABASE_URL=postgres://helpudoc:helpudoc@localhost:5432/helpudoc
DATABASE_SSL=false

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORE_PROVIDER=s3
S3_BUCKET_NAME=helpudoc
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Repo-root-relative paths are supported even when backend/agent are started
# from their own subdirectories.
WORKSPACE_ROOT=backend/workspaces
SKILLS_ROOT=skills
PLUGINS_ROOT=plugins
ENABLE_SKILL_SANDBOX_RUNNER=true
HELPUDOC_SANDBOX_BACKEND=local
SANDBOX_INLINE_ENABLED=false
SANDBOX_INLINE_MAX_GLOBAL_JOBS=4

# Langfuse (optional; LANGFUSE_ENABLED must be true to activate agent tracing)
# LANGFUSE_ENABLED=true
# LANGFUSE_TRACING_ENABLED=false
# OTEL_SDK_DISABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
AGENT_CONFIG_PATH=agent/config/runtime.yaml
ADMIN_EMAILS=admin@local.com

# Local-only credentials. Keep real values in env/local/dev.env, which is
# ignored by git. Use scripts/bootstrap_local_env.sh to create that file.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_SEARCH_HTTP_TIMEOUT_SECONDS=90
GOOGLE_SEARCH_TIMEOUT_SECONDS=100
GOOGLE_SEARCH_MAX_ATTEMPTS=2
GOOGLE_SEARCH_MAX_CONSECUTIVE_FAILURES=2
GOOGLE_SEARCH_RETRY_BASE_DELAY_SECONDS=1
VITE_GOOGLE_CLIENT_ID=16646144790-fvdv7liepgo18aiu20n3btmdr56l33pq.apps.googleusercontent.com
VITE_AUTH_MODE=headers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_OAUTH_POST_LOGIN_REDIRECT=http://localhost:5173/login
GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/bigquery https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/spreadsheets.readonly"
GOOGLE_WORKSPACE_MCP_URL=
# Generate a 32-byte base64url key, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OAUTH_TOKEN_ENCRYPTION_KEY=
