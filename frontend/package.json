    "@docx-editor.dev/react": "2.19.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@helpudoc/contracts": "file:../packages/contracts",
    "@helpudoc/dashboard-runtime": "file:../packages/dashboard-runtime",
    "@mdxeditor/editor": "^3.48.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "autoprefixer": "^10.4.21",
    "hyparquet": "^1.25.1",
    "hyparquet-compressors": "^1.1.1",
    "jszip": "^3.10.1",
