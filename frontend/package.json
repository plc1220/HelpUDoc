{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/remove-startup-preloads.mjs",
    "build:docker": "vite build && node scripts/remove-startup-preloads.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e": "playwright test --project=chromium",
    "e2e:production:slides": "RUN_PRODUCTION_SLIDES_E2E=1 playwright test e2e/production-slides-smoke.spec.ts --project=chromium"
  },
  "dependencies": {
