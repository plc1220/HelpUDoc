    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^11.12.0",
    "micromark-extension-gfm": "^3.0.0",
    "monaco-editor": "^0.54.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^4.10.38",
    "plotly.js-dist-min": "^3.3.0",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^7.9.4",
    "react-syntax-highlighter": "^16.0.0",
