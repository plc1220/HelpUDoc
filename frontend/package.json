    "@types/papaparse": "^5.5.0",
    "@types/plotly.js": "^3.0.8",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/react-plotly.js": "^2.6.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^9.36.0",
