# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

WORKDIR /app/agent

# System tools used by report workloads.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    curl \
    libreoffice-calc \
  && rm -rf /var/lib/apt/lists/*

COPY agent/requirements-documents.txt /app/agent/requirements-documents.txt
COPY agent/requirements-reporting.txt /app/agent/requirements-reporting.txt

RUN --mount=type=cache,target=/root/.cache/pip \
  pip install -r /app/agent/requirements-documents.txt -r /app/agent/requirements-reporting.txt
