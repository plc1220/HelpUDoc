# syntax=docker/dockerfile:1.7
# Node.js for declared JavaScript and TypeScript skill scripts. Debian's
# nodejs is 18, end of life since April 2025, and cannot run .ts. Node 22.18+
# strips TypeScript types itself, so no tsx or npm is needed. Copy only the
# binary: with npm present, frontend-slides' export-pptx.py would try to
# download Playwright inside a sandbox that has no egress and hang to timeout.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS node

FROM python:3.12-slim-bookworm

WORKDIR /app/agent

ARG GIT_COMMIT=unknown
ARG TARGETARCH
ARG OFFICECLI_VERSION=1.0.143
ARG OFFICECLI_SHA256_AMD64=6a29c598a789b57c92c03e560907d3f131a4bd0a068785b1d338a86fc31a58a7
ARG OFFICECLI_SHA256_ARM64=c50298e4698fcd1b15fe1a0f096405ad260b5c84d4440882582d0bba1e57bd49

# Keep only runtime tools required by plugins.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    curl \
    libicu72 \
    libreoffice-calc \
  && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN node --version

RUN set -eux; \
  case "${TARGETARCH}" in \
    amd64) \
      OFFICECLI_URL="https://github.com/iOfficeAI/OfficeCLI/releases/download/v${OFFICECLI_VERSION}/officecli-linux-x64"; \
      EXPECTED_SHA="${OFFICECLI_SHA256_AMD64}"; \
      ;; \
    arm64) \
      OFFICECLI_URL="https://github.com/iOfficeAI/OfficeCLI/releases/download/v${OFFICECLI_VERSION}/officecli-linux-arm64"; \
      EXPECTED_SHA="${OFFICECLI_SHA256_ARM64}"; \
      ;; \
    *) echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
  esac; \
  curl -fsSL "${OFFICECLI_URL}" -o /usr/local/bin/officecli; \
  echo "${EXPECTED_SHA}  /usr/local/bin/officecli" | sha256sum -c -; \
  chmod +x /usr/local/bin/officecli; \
  officecli --version

# Copy dependency manifests first so `pip install` layer caches across code/skills changes.
COPY agent/requirements*.txt /app/agent/

RUN --mount=type=cache,target=/root/.cache/pip \
  pip install -r /app/agent/requirements-runtime.txt

ARG GCP_COST_MCP_VERSION=v0.8.0
RUN curl -fsSL -o /usr/local/bin/gcp-cost-mcp-server \
    "https://github.com/nozomi-koborinai/gcp-cost-mcp-server/releases/download/${GCP_COST_MCP_VERSION}/gcp-cost-mcp-server-linux-amd64" \
  && chmod +x /usr/local/bin/gcp-cost-mcp-server

COPY agent/scripts/gcp-cost-mcp-wrapper.sh /usr/local/bin/gcp-cost-mcp-wrapper
RUN chmod +x /usr/local/bin/gcp-cost-mcp-wrapper

# Copy agent code and runtime assets. Bundled source paths are used by GKE initContainers to seed PVCs.
COPY agent/ /app/agent/
COPY skills/ /app/skills-source/
COPY plugins/ /app/plugins-source/
RUN mkdir -p /app/agent-config-source \
  && cp /app/agent/config/runtime.yaml /app/agent-config-source/runtime.yaml \
  && printf '%s\n' "${GIT_COMMIT}" > /app/skills-source/.HELPUDOC_SOURCE_REVISION \
  && cp /app/skills-source/.HELPUDOC_SOURCE_REVISION /app/plugins-source/.HELPUDOC_SOURCE_REVISION \
  && cp /app/skills-source/.HELPUDOC_SOURCE_REVISION /app/agent-config-source/.HELPUDOC_SOURCE_REVISION
COPY skills/ /app/skills/
COPY plugins/ /app/plugins/

ENV OFFICECLI_SKIP_UPDATE=1 \
    OFFICECLI_NO_AUTO_RESIDENT=1

EXPOSE 8001
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
